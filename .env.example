# ===== Google Gemini (prototyping) =====
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ===== Models =====
EMBEDDING_MODEL=mainguyen9/vietlegal-harrier-0.6b
EMBEDDING_DIM=1024
RERANKER_MODEL=AITeamVN/Vietnamese_Reranker

# ===== Hardware =====
DEVICE=cpu

# ===== Retrieval =====
BM25_K1=1.5
BM25_B=0.75
RETRIEVAL_TOP_K=500
RERANK_TOP_K=50
FINAL_TOP_K=20
SCORE_THRESHOLD=0.7

# ===== Generation =====
MAX_TOKENS=8192
TEMPERATURE=0.1

# ===== Paths =====
DATA_DIR=data
INDEX_DIR=data/indexes
